Algoritmo "soma_notas"

Var
   nota1, nota2, nota3, soma: real

Inicio
   leia(nota1)
   leia(nota2)
   leia(nota3)

   soma <- nota1 + nota2 + nota3

   escreva(soma)

FimAlgoritmo
_______________________________________________________________

